{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(node:*)",
      "Bash(npm run lint)",
      "Bash(npm run build:*)",
      "Bash(mkdir:*)",
      "Bash(npx tsc:*)",
      "Bash(npx jest:*)",
      "Bash(rg:*)",
      "Bash(npm run lint:*)",
      "Bash(npx eslint:*)",
      "Bash(npm run test:*)",
      "Bash(sed:*)",
      "Read(//Users/elrocie/**)",
      "Read(//Users/elrocie/.claude/**)",
      "Bash(git clone:*)",
      "Bash(git config:*)",
      "Bash(GIT_TRACE=1 timeout 120 git clone https://github.com/zbirenbaum/copilot.lua.git)",
      "Bash(ping:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(test:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "WebFetch(domain:github.com)",
      "Bash(git rebase:*)",
      "WebSearch",
      "Bash(git rm:*)"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "commit-commands@claude-code-plugins": true,
    "pr-review-toolkit@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "frontend-design@claude-code-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "aws-dev-toolkit@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true,
    "aws-agents@claude-plugins-official": true,
    "redis-development@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:purple-user",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "planStoragePath": ".planning",
  "feedbackSurveyState": {
    "lastShownTime": 1754041961165
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--user-data-dir",
        "/Users/elrocie/.playwright-profiles",
        "--channel",
        "chrome"
      ]
    }
  },
  "inputNeededNotifEnabled": true
}
