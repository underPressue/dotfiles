# show desktop
cmd + alt + ctrl + shift - h : skhd -k "cmd - h"
cmd + alt + ctrl + shift - delete : open -a "cmd - q"

# Attach iPad (Uranus) as Sidecar display
cmd + alt + ctrl + shift - e : ~/Sidecar connect Uranus

# tile frontmost window to left/right half (native Move & Resize)
cmd + alt + ctrl + shift - up : skhd -k "ctrl + cmd - f"
cmd + alt + ctrl + shift - right : ~/.config/skhd/tile.sh right
cmd + alt + ctrl + shift - left : ~/.config/skhd/tile.sh left

